# Supabase project settings > API. Publishable key is designed for browser use; RLS is mandatory.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# Use a model supporting structured JSON output and an audio transcription model.
OPENAI_SUMMARY_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Absolute production origin for invitation redirects. No trailing slash.
APP_URL=http://localhost:3000
